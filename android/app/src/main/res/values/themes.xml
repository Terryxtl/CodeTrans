<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material Design 2 (MaterialComponents), follows the system light / dark setting. -->
    <style name="Theme.CodeTrans" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/teal_800</item>
        <item name="colorPrimaryVariant">@color/teal_900</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/amber_400</item>
        <item name="colorSecondaryVariant">@color/amber_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="materialCardViewStyle">@style/Widget.CodeTrans.CardView</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>

    <style name="Widget.CodeTrans.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">8dp</item>
    </style>

    <style name="Widget.CodeTrans.Toolbar" parent="Widget.MaterialComponents.Toolbar.PrimarySurface">
        <item name="android:elevation">4dp</item>
    </style>

    <style name="TextAppearance.CodeTrans.Status" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/white</item>
    </style>
</resources>
