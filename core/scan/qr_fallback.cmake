# Use the same QR-only reader and adapter in both camera receivers.
function(cp_enable_qr_fallback target)
  set(adapter "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../android/app/src/main/cpp")
  set(BUILD_SHARED_LIBS OFF)
  set(CMAKE_CXX_STANDARD 20)
  set(ZXING_READERS ON)
  set(ZXING_WRITERS OFF)
  set(ZXING_C_API OFF)
  foreach(format 1D AZTEC DATAMATRIX MAXICODE PDF417)
    set(ZXING_ENABLE_${format} OFF)
  endforeach()
  add_subdirectory("${adapter}/third_party/zxing-cpp/core" zxing EXCLUDE_FROM_ALL)
  target_sources(${target} PRIVATE "${adapter}/qr_fallback.cpp")
  target_include_directories(${target} PRIVATE "${adapter}")
  target_compile_definitions(${target} PRIVATE CP_WITH_ZXING)
  target_compile_features(${target} PRIVATE cxx_std_20)
  target_link_libraries(${target} PRIVATE ZXing::ZXing)
endfunction()
